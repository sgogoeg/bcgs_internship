 RowBox[{
  RowBox[{"Series", "[", 
   RowBox[{
    RowBox[{"sigma", "[", "s", "]"}], ",", 
    RowBox[{"{", 
     RowBox[{"s", ",", 
      RowBox[{"4", 
       RowBox[{"mx", "^", "2"}]}], ",", "2"}], "}"}]}], "]"}], "//", 
