       RowBox[{"(", 
        RowBox[{"s", "-", 
         RowBox[{"4", " ", 
          SuperscriptBox["mx", "2"]}]}], ")"}], 
       RowBox[{"5", "/", "2"}]], ")"}],
     SeriesData[$CellContext`s, 4 $CellContext`mx^2, {}, 1, 5, 2],
     Editable->False]}],
   SeriesData[$CellContext`s, 4 $CellContext`mx^2, {
    Rational[1, 3] (-$CellContext`mf^2 + $CellContext`mx^2)^
      Rational[1, 2] ($CellContext`mf^2 + 
