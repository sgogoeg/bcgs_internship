Cell[BoxData[
 FormBox[
  InterpretationBox[
   RowBox[{
    FractionBox[
     RowBox[{
      SqrtBox[
       RowBox[{
        SuperscriptBox["mx", "2"], "-", 
        SuperscriptBox["mf", "2"]}]], " ", 
      RowBox[{"(", 
       RowBox[{
        SuperscriptBox["mf", "2"], "+", 
        RowBox[{"5", " ", 
         SuperscriptBox["mx", "2"]}]}], ")"}], " ", 
      SqrtBox[
       RowBox[{"s", "-", 
        RowBox[{"4", " ", 
         SuperscriptBox["mx", "2"]}]}]], " ", 
      TemplateBox[{
        RowBox[{
          RowBox[{
            RowBox[{"Srqt", "(", 
              RowBox[{"4", " ", 
                SuperscriptBox["mx", "2"]}], ")"}], "-", 
            RowBox[{"2", " ", "mf"}]}]}]},
       "HeavisideThetaSeq"]}], 
     RowBox[{"3", " ", 
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          SuperscriptBox["ma", "2"], " ", "mx"}], "-", 
         RowBox[{"4", " ", 
          SuperscriptBox["mx", "3"]}]}], ")"}], "2"]}]], "-", 
    FractionBox[
     RowBox[{
      SuperscriptBox[
       RowBox[{"(", 
