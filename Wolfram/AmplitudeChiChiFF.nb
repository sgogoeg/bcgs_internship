       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           SuperscriptBox["ma", "2"], " ", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"2", " ", 
              SuperscriptBox["mf", "4"]}], "-", 
             RowBox[{
              SuperscriptBox["mf", "2"], " ", 
              SuperscriptBox["mx", "2"]}], "+", 
             RowBox[{"5", " ", 
              SuperscriptBox["mx", "4"]}]}], ")"}]}], "+", 
          RowBox[{"12", " ", 
           SuperscriptBox["mx", "2"], " ", 
