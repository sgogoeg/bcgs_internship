Cell["\<\
Now we want to expand the scattering amplitude around s = 4m_x^2, so around \
the non relativistic limit\
\>", "Text",
 CellChangeTimes->{{3.995339922278837*^9, 
  3.995339965678563*^9}},ExpressionUUID->"04d31186-98ee-4176-83de-\
fd876aa645ef"],

Cell[BoxData[
 RowBox[{
  RowBox[{"sigma", "[", "s_", "]"}], " ", ":=", " ", 
  RowBox[{
   RowBox[{
    RowBox[{"(", 
     RowBox[{"s", "-", 
      RowBox[{"4", "*", 
       RowBox[{"mf", "^", "2"}]}]}], ")"}], "^", 
    RowBox[{"(", 
     RowBox[{"1", "/", "2"}], ")"}]}], "*", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"s", "-", 
      RowBox[{"4", "*", 
       RowBox[{"mx", "^", "2"}]}]}], ")"}], "^", 
    RowBox[{"(", 
     RowBox[{"1", "/", "2"}], ")"}]}], "*", 
   RowBox[{"(", 
    RowBox[{"s", "-", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"s", "-", 
         RowBox[{"4", 
          RowBox[{"mf", "^", "2"}]}]}], ")"}], "/", "6"}], ")"}]}], ")"}], "*", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"HeavisideTheta", "[", 
      RowBox[{
       RowBox[{"Srqt", "[", "s", "]"}], "-", 
       RowBox[{"2", "mf"}]}], "]"}], ")"}], "/", 
    RowBox[{"(", 
     RowBox[{"s", "*", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"s", "-", 
         RowBox[{"ma", "^", "2"}]}], ")"}], "^", "2"}]}], 
     ")"}]}]}]}]], "Input",
 CellChangeTimes->{{3.994923423188306*^9, 3.994923423188348*^9}, {
  3.994924337207098*^9, 3.9949243643618402`*^9}, {3.994924405619474*^9, 
  3.994924411747325*^9}, {3.995340106729216*^9, 3.995340255318493*^9}, {
  3.995340292561121*^9, 3.995340308305724*^9}},
 CellLabel->"In[14]:=",ExpressionUUID->"0ea41c50-3794-4bc9-929e-23b362bcd0f9"],

