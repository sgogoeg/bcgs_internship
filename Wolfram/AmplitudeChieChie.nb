    Rational[1, 3] (-$CellContext`mf^2 + $CellContext`mx^2)^
      Rational[1, 2] ($CellContext`mf^2 + 
      5 $CellContext`mx^2) ($CellContext`ma^2 $CellContext`mx - 
       4 $CellContext`mx^3)^(-2) 
     HeavisideTheta[(-2) $CellContext`mf + $CellContext`Srqt[
        4 $CellContext`mx^2]], 0, 
     Rational[-1, 
       24] $CellContext`mx^(-4) (-$CellContext`mf^2 + $CellContext`mx^2)^
      Rational[-1, 2] (-$CellContext`ma^2 + 4 $CellContext`mx^2)^(-3) (
      12 $CellContext`mx^2 ((-2) $CellContext`mf^4 - 
        5 $CellContext`mf^2 $CellContext`mx^2 + 
        5 $CellContext`mx^4) + $CellContext`ma^2 (
        2 $CellContext`mf^4 - $CellContext`mf^2 $CellContext`mx^2 + 
        5 $CellContext`mx^4)) 
     HeavisideTheta[(-2) $CellContext`mf + $CellContext`Srqt[
        4 $CellContext`mx^2]]}, 1, 5, 2],
   Editable->False], TraditionalForm]], "Output",
