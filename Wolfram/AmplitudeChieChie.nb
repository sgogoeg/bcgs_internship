Cell[BoxData[
 FormBox[
  InterpretationBox[
   RowBox[{
    FractionBox[
     RowBox[{
      SqrtBox[
       RowBox[{
        SuperscriptBox["mx", "2"], "-", 
        SuperscriptBox["mf", "2"]}]], " ", 
      RowBox[{"(", 
       RowBox[{
        SuperscriptBox["mf", "2"], "+", 
        RowBox[{"5", " ", 
         SuperscriptBox["mx", "2"]}]}], ")"}], " ", 
      SqrtBox[
       RowBox[{"s", "-", 
        RowBox[{"4", " ", 
         SuperscriptBox["mx", "2"]}]}]], " ", 
      TemplateBox[{
        RowBox[{
          RowBox[{
            RowBox[{"Srqt", "(", 
              RowBox[{"4", " ", 
                SuperscriptBox["mx", "2"]}], ")"}], "-", 
            RowBox[{"2", " ", "mf"}]}]}]},
       "HeavisideThetaSeq"]}], 
     RowBox[{"3", " ", 
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          SuperscriptBox["ma", "2"], " ", "mx"}], "-", 
         RowBox[{"4", " ", 
          SuperscriptBox["mx", "3"]}]}], ")"}], "2"]}]], "-", 
    FractionBox[
     RowBox[{
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{"s", "-", 
         RowBox[{"4", " ", 
          SuperscriptBox["mx", "2"]}]}], ")"}], 
       RowBox[{"3", "/", "2"}]], " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           SuperscriptBox["ma", "2"], " ", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"2", " ", 
              SuperscriptBox["mf", "4"]}], "-", 
             RowBox[{
              SuperscriptBox["mf", "2"], " ", 
              SuperscriptBox["mx", "2"]}], "+", 
             RowBox[{"5", " ", 
              SuperscriptBox["mx", "4"]}]}], ")"}]}], "+", 
          RowBox[{"12", " ", 
           SuperscriptBox["mx", "2"], " ", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"-", 
              RowBox[{"2", " ", 
               SuperscriptBox["mf", "4"]}]}], "-", 
             RowBox[{"5", " ", 
              SuperscriptBox["mf", "2"], " ", 
              SuperscriptBox["mx", "2"]}], "+", 
             RowBox[{"5", " ", 
              SuperscriptBox["mx", "4"]}]}], ")"}]}]}], ")"}], " ", 
        TemplateBox[{
          RowBox[{
            RowBox[{
              RowBox[{"Srqt", "(", 
                RowBox[{"4", " ", 
                  SuperscriptBox["mx", "2"]}], ")"}], "-", 
              RowBox[{"2", " ", "mf"}]}]}]},
         "HeavisideThetaSeq"]}], ")"}]}], 
     RowBox[{"24", " ", 
      RowBox[{"(", 
       RowBox[{
        SuperscriptBox["mx", "4"], " ", 
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{
           RowBox[{"4", " ", 
            SuperscriptBox["mx", "2"]}], "-", 
           SuperscriptBox["ma", "2"]}], ")"}], "3"], " ", 
        SqrtBox[
         RowBox[{
          SuperscriptBox["mx", "2"], "-", 
          SuperscriptBox["mf", "2"]}]]}], ")"}]}]], "+", 
    InterpretationBox[
     RowBox[{"O", "(", 
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{"s", "-", 
         RowBox[{"4", " ", 
          SuperscriptBox["mx", "2"]}]}], ")"}], 
       RowBox[{"5", "/", "2"}]], ")"}],
     SeriesData[$CellContext`s, 4 $CellContext`mx^2, {}, 1, 5, 2],
