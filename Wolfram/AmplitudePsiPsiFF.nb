Cell["For a Dirac fermion, the traces are different:", "Text",
 CellChangeTimes->{{3.9956944495636663`*^9, 
  3.995694464580902*^9}},ExpressionUUID->"84dc4849-fd9e-4ec4-8c85-\
c049d460a663"],

Cell[BoxData[
 RowBox[{
  RowBox[{"SetMandelstam", "[", 
   RowBox[{"s", ",", "t", ",", "u", ",", "p1", ",", "p2", ",", 
    RowBox[{"-", "p3"}], ",", 
    RowBox[{"-", "p4"}], ",", "mpsi", ",", "mpsi", ",", "mf", ",", "mf"}], 
   "]"}], ";"}]], "Input",
 CellChangeTimes->{{3.995694576105995*^9, 3.995694582288982*^9}, {
  3.9972613205024557`*^9, 3.9972613248455563`*^9}},
 CellLabel->"In[2]:=",ExpressionUUID->"b169d0e5-327e-4d25-a13c-58666dacaf1e"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"res", " ", "=", " ", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"DiracTrace", "[", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"GS", "[", "p1", "]"}], "+", "mpsi"}], ")"}], ".", 
       RowBox[{"GA", "[", "nu", "]"}], ".", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"GS", "[", "p2", "]"}], "-", "mpsi"}], ")"}], ".", 
       RowBox[{"GA", "[", "mu", "]"}]}], "]"}], "*", 
     RowBox[{"DiracTrace", "[", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"GS", "[", "p3", "]"}], "+", "mf"}], ")"}], ".", 
       RowBox[{"GA", "[", "mu", "]"}], ".", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"GS", "[", "p4", "]"}], "-", "mf"}], ")"}], ".", 
       RowBox[{"GA", "[", "nu", "]"}]}], "]"}]}], "//", "DiracSimplify"}], "//",
    "Simplify"}]}]], "Input",
 CellChangeTimes->{{3.995694593713213*^9, 3.9956946953089027`*^9}, {
  3.995695082558*^9, 3.995695083533263*^9}},
 CellLabel->"In[3]:=",ExpressionUUID->"f9426d59-24d8-4829-a14c-a0e63b973507"],

